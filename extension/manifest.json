{
  "manifest_version": 3,
  "name": "Manga Temizleyici (YOLO)",
  "version": "1.0",
  "description": "Alt + Tık ile manga balonlarını temizle",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}